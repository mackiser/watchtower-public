# Copy this file to .env and fill in real values. Never commit the real .env.

# Postgres connection string used by the API (and the Prisma CLI) for LOCAL dev / `npm run dev`.
DATABASE_URL=postgresql://watchtower:watchtower@localhost:5432/watchtower

# --- Docker Compose deploy only (docker-compose.yml) ---
# For a fresh PRODUCTION deployment, set a strong DB password here BEFORE the first `up` (Postgres
# only applies it when it initializes an empty volume). The compose file builds DATABASE_URL from
# these, so the app and db stay in sync. POSTGRES_PASSWORD is REQUIRED (compose refuses to start
# without it) - existing volumes keep whatever password they were initialized with.
POSTGRES_USER=watchtower
POSTGRES_PASSWORD=replace-with-a-strong-password-for-production
POSTGRES_DB=watchtower

# Session cookie signing secret — at least 16 characters, ideally 32+ random ones.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Idle timeout: a session ends after this many minutes without any request (activity in the app
# keeps it alive). Defaults to 30 when unset.
SESSION_IDLE_MINUTES=30

# Absolute session lifetime: force re-authentication this many hours after login, regardless of
# activity. Defaults to 12 when unset.
SESSION_MAX_HOURS=12

# Encrypts users' TOTP (multi-factor) secrets at rest — at least 16 chars, ideally 32+ random.
# Generate one with: openssl rand -hex 32. Keep it stable: if this changes or is lost, every
# enrolled user is locked out of MFA and must be reset by an admin and re-enroll.
MFA_ENCRYPTION_KEY=replace-with-a-long-random-string

# Port the API listens on. In production the API also serves the built frontend (see
# apps/api/src/app.ts), so this is the only port you need to expose.
PORT=4000
NODE_ENV=production

# Session cookies are Secure (HTTPS-only) by default in production — correct behind a
# TLS-terminating reverse proxy. If you're deploying to a plain-HTTP internal/LAN box (no reverse
# proxy adding TLS), set this to false, or login will appear to succeed but every subsequent
# request will look logged-out.
COOKIE_SECURE=true

# First admin account — created once by `npm run seed:admin` (apps/api/src/seedAdmin.ts).
# There's no public signup route by design; every other account is created afterward via
# the in-app Admin > Users page.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Admin

# Local dev only — lets the Vite dev server (apps/web, port 5173) call the API on a different
# port with cookies/CORS working correctly. Not used in production (single-origin deployment).
WEB_DEV_ORIGIN=http://localhost:5173

# --- Qualys VM API daily sync ---
# Credentials for a dedicated Qualys API service account (SAML SSO must be OFF for this user —
# the Qualys API only accepts native username/password Basic auth). Leave both blank to disable
# the sync entirely; the app boots fine without them.
# Your subscription's API server (shown in Qualys under Help > About), e.g. qualysapi.qg2.apps.qualys.com
QUALYS_API_URL=https://qualysapi.qualys.com
QUALYS_USERNAME=
QUALYS_PASSWORD=
# Timezone for the daily 5pm sync (default shown).
# QUALYS_SYNC_TZ=America/New_York
# API version for the KnowledgeBase lookup that fills in vulnerability titles and remediation for
# the Top vulnerabilities table. Kept separate from the asset endpoints (pinned to 5.0 in code,
# because 2.0 is EOS for those paths) — the KnowledgeBase is documented at 2.0 and it is not safe
# to assume the same version applies. Override here if this tenant answers on a different one; a
# wrong version fails soft, leaving the table showing bare QIDs.
# QUALYS_KB_API_VERSION=2.0

# Copy to .env.demo (gitignored). Generate secrets with: openssl rand -hex 32
# The demo is read-only and its login is shown on the sign-in page, so DEMO_* is not a secret.

# --- Docker Compose demo (docker-compose.demo.yml) ---
POSTGRES_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-string
MFA_ENCRYPTION_KEY=replace-with-a-long-random-string
DEMO_ADMIN_EMAIL=demo@watchtower.dev
DEMO_ADMIN_PASSWORD=watchtower-demo

# --- One-time seed of a hosted database (`npm run demo:setup`, see README "Live demo") ---
# Use the DIRECT (non-pooled) connection string here — migrations need it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DEMO_SEED=1
ADMIN_EMAIL=demo@watchtower.dev
ADMIN_PASSWORD=watchtower-demo
ADMIN_NAME=Demo User
